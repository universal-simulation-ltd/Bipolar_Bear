rules_version = '2';

// Firestore security rules for the bipolarbear-app project.
//
// Tested by scripts/firestore-rules (emulator suite): run `npm test` there
// before deploying. Deploy with `firebase deploy --only firestore:rules`.
//
// Compatibility switch: store builds before the 2026-10-12 privacy round
// (Bipolar Bear <= 1.41, Bipolar Anonymous <= 1.40) write board posts,
// comments and monika reservations with no owner stamp, or with the author's
// `uid` (which the anonOwnerOn* Cloud Functions swap for an owner stamp as it
// lands); they also write the sensitive userSettings fields and personal
// details in plaintext, and send `emailHash` with their push registration.
// While those builds are in use, legacyClients() stays true. Once they are
// gone, set it to false: the test suite runs against both settings.
//
// Privacy round 2026-10-12 (functions/privacy.js):
//   * public board documents carry `owner` = sha256(uid + '/' + doc path),
//     never the uid;
//   * board profiles are keyed 'p2_' + HMAC(server secret, email), and a
//     session owns one when bbAnonLinks/{uid}.profileIds lists it; no more
//     read window for anyone holding the email hash, no more open delete;
//   * personal details and the sensitive userSettings fields are AES-GCM
//     ciphertext (`secureEnc`) written on the device.

service cloud.firestore {
  match /databases/{database}/documents {

    function legacyClients() { return true; }

    // ── Identity ─────────────────────────────────────────────────────────

    function signedIn() { return request.auth != null; }

    // The token carries a verified email whose sha256(lower-case) is `hash`
    // (Bipolar Bear accounts).
    function tokenEmailHashIs(hash) {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '') != ''
        && hashing.sha256(request.auth.token.get('email', '').trim().lower()).toHexString().lower() == hash;
    }

    // The session proved the address with an email code. bbAnonLinks is
    // written only by Cloud Functions (verifyAnonCode, anonProfileId).
    function link() { return get(/databases/$(database)/documents/bbAnonLinks/$(request.auth.uid)).data; }
    function hasLink() {
      return signedIn() && exists(/databases/$(database)/documents/bbAnonLinks/$(request.auth.uid));
    }
    function linkedEmailHashIs(hash) {
      return hasLink()
        && (link().get('emailHash', '') == hash || link().get('emailHashes', []).hasAny([hash]));
    }
    // The session may use the board profile `id` ('p2_…', see anonProfiles).
    function linkedProfileIs(id) {
      return hasLink() && link().get('profileIds', []).hasAny([id]);
    }

    function ownsEmailHash(hash) {
      return tokenEmailHashIs(hash) || linkedEmailHashIs(hash);
    }

    // Board admin: the admin's Bipolar Bear account, or a session that proved
    // the admin address with an email code.
    function isAdmin() {
      return signedIn()
        && (request.auth.token.get('email', '') == 'inbox@jamesmarkey.co.uk'
            || linkedEmailHashIs('cc88532256c8a4beb05e227784b2669afcd1448dc28ac05b173d6c1fe0182bc7'));
    }

    // ── Shared helpers ───────────────────────────────────────────────────

    function incoming() { return request.resource.data; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // An integer field moved by exactly +1 or -1 (missing counts as 0).
    function stepped(field) {
      return incoming().get(field, 0) is int
        && resource.data.get(field, 0) is int
        && (incoming().get(field, 0) - resource.data.get(field, 0) == 1
            || incoming().get(field, 0) - resource.data.get(field, 0) == -1);
    }

    // The owner stamp for the document at `docPath` (e.g. 'bbAnonPosts/abc'):
    // sha256(uid + '/' + docPath). Different for every document, so public
    // documents can't be tied to each other or to an account.
    function ownerStamp(docPath) {
      return hashing.sha256(request.auth.uid + '/' + docPath).toHexString().lower();
    }

    // A new document carries the writer's owner stamp; or (store builds from
    // before 2026-10-12 only) their uid, swapped for a stamp server-side as it
    // lands, or nothing at all.
    function ownerOnCreate(docPath) {
      return ('owner' in incoming())
        ? (signedIn() && incoming().owner == ownerStamp(docPath) && !('uid' in incoming()))
        : (('uid' in incoming())
            ? (legacyClients() && signedIn() && incoming().uid == request.auth.uid)
            : legacyClients());
    }

    // An existing document belongs to the caller (or predates owner stamps and
    // legacy builds are still supported).
    function ownsExisting(docPath) {
      return ('owner' in resource.data)
        ? (signedIn() && resource.data.owner == ownerStamp(docPath))
        : (('uid' in resource.data)
            ? (signedIn() && resource.data.uid == request.auth.uid)
            : legacyClients());
    }

    function adminFlagOk() {
      return incoming().get('isAdmin', false) == false || isAdmin();
    }

    // ── Cloud Functions only (Admin SDK bypasses rules) ──
    match /anonVerify/{docId}      { allow read, write: if false; }
    match /verifyRateLimit/{docId} { allow read, write: if false; }
    match /betaSignups/{docId}     { allow read, write: if false; }
    match /bbAnonLinks/{uid}       { allow read, write: if false; }
    // Universal ID ↔ Bipolar Bear account join (uidSignIn / uidLink).
    match /uidLinks/{supabaseId}   { allow read, write: if false; }

    // ── Anonymous board ──────────────────────────────────────────────────
    match /bbAnonPosts/{postId} {
      allow read: if true;

      function isTopicDoc() { return resource.data.get('isTopic', false) == true; }

      function createShapeOk() {
        return adminFlagOk()
          && (incoming().get('tab', '') != 'announcements' || isAdmin())
          && (incoming().get('pinned', false) == false || isAdmin())
          && incoming().get('likes', 0) == 0
          && incoming().get('commentCount', 0) == 0
          && incoming().get('deleted', false) == false
          && incoming().get('reported', false) == false
          && incoming().get('wasTopic', false) == false
          && !('poll' in incoming())               // polls: createAnonPoll callable
          && incoming().get('timestamp', null) == request.time;
      }

      // The daily topic is written by whichever client first sees it is due,
      // under a deterministic id.
      function topicCreateOk() {
        return signedIn()
          && incoming().get('isTopic', false) == true
          && incoming().get('dayStr', '') is string
          && postId == 'topic-' + incoming().get('dayStr', '')
          && incoming().get('tab', '') == 'general';
      }

      function postPath() { return 'bbAnonPosts/' + postId; }

      allow create: if createShapeOk()
        && (incoming().get('isTopic', false) == true ? topicCreateOk() : ownerOnCreate(postPath()));

      // Updates any member may make to any post.
      function likeOk()   { return changedKeys().hasOnly(['likes']) && stepped('likes'); }
      function replyOk()  {
        return changedKeys().hasOnly(['commentCount', 'lastActivity'])
          && (!changedKeys().hasAny(['commentCount']) || stepped('commentCount'))
          && (!changedKeys().hasAny(['lastActivity']) || incoming().lastActivity == request.time);
      }
      function reportOk() { return changedKeys().hasOnly(['reported']) && incoming().reported == true; }
      // Retiring an old daily topic into an ordinary post.
      function topicRetireOk() {
        return isTopicDoc()
          && changedKeys().hasOnly(['isTopic', 'wasTopic', 'isAdmin', 'name', 'initials', 'grad1', 'grad2', 'streak'])
          && incoming().isTopic == false
          && incoming().get('wasTopic', false) == true
          && incoming().get('isAdmin', false) == false;
      }
      // The author renaming their monika.
      function renameOk() {
        return changedKeys().hasOnly(['name', 'initials', 'grad1', 'grad2'])
          && !isTopicDoc()
          && ownsExisting(postPath());
      }

      allow update: if likeOk() || replyOk() || reportOk() || topicRetireOk() || renameOk() || isAdmin();

      // Retention sweep (7 days, with a day of slack for device clocks).
      function expired() {
        return resource.data.get('timestamp', null) is timestamp
          && resource.data.timestamp < request.time - duration.value(6, 'd')
          && resource.data.get('reported', false) != true
          && resource.data.get('pinned', false) != true
          && !isTopicDoc()
          && (!(resource.data.get('lastActivity', null) is timestamp)
              || resource.data.lastActivity < request.time - duration.value(6, 'd'));
      }

      allow delete: if (isTopicDoc() && resource.data.get('commentCount', 0) == 0)
        || expired()
        || (!isTopicDoc() && ownsExisting(postPath()))
        || isAdmin();

      match /comments/{commentId} {
        function commentPath() { return 'bbAnonPosts/' + postId + '/comments/' + commentId; }
        allow read: if true;
        allow create: if signedIn()
          && adminFlagOk()
          && incoming().get('timestamp', null) == request.time
          && ownerOnCreate(commentPath());
        allow update: if isAdmin();
        allow delete: if signedIn() && (ownsExisting(commentPath()) || isAdmin());
      }
    }

    // Collection-group reads of replies: BB.anonPostCount.seed (js/shared/
    // brand-config.js) counts a member's replies across every thread for the
    // 💬 all-time figure. Replies are already public through the bbAnonPosts
    // match above, and bbAnonPosts is the only parent with a `comments`
    // subcollection. Reads only; writes still go through that match.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // Monika reservations: doc id = lower-cased monika.
    match /bbAnonMonikas/{id} {
      allow get: if true;
      allow create: if incoming().get('monika', '') is string
        && incoming().get('monika', '').lower() == id
        && incoming().keys().hasOnly(['monika', 'createdAt', 'uid', 'owner'])
        && ownerOnCreate('bbAnonMonikas/' + id);
      allow delete: if ownsExisting('bbAnonMonikas/' + id) || isAdmin();
    }

    // Cross-device board profile.
    //   'p2_' + HMAC(server secret, email) — the current id. Only the server
    //   can work it out; a session owns it when bbAnonLinks lists it.
    //   sha256(email) — the old id, still written by store builds from before
    //   2026-10-12. Owner-only (a verified account email or an email code);
    //   privacySweep / the next sign-in moves it to the new id.
    // Nobody else can read, write or delete either kind, at any time.
    match /anonProfiles/{id} {
      function isCurrentId() { return id.matches('^p2_[0-9a-f]{64}$'); }
      function owns() { return isCurrentId() ? linkedProfileIs(id) : ownsEmailHash(id); }
      allow get: if owns();
      allow create: if owns()
        && !incoming().keys().hasAny(['restoreUntil', 'compatCopy', 'compatUntil']);
      allow update: if owns() && !changedKeys().hasAny(['restoreUntil', 'compatCopy', 'compatUntil']);
      // Deleting nothing is harmless, and older builds' account deletion does
      // it for a profile that has already moved.
      allow delete: if owns() || resource == null;
    }

    match /bbAnonReports/{docId} { allow create: if true; }

    match /bbAnonBanned/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Member-suggested announcements awaiting the admin.
    // Pending suggestions are the admin's to read. Members open their own by id
    // (kept on the device that wrote it); ids are random and nobody but the
    // admin can list the collection.
    match /bbAnonAnnSuggestions/{id} {
      allow list:   if isAdmin();
      allow get:    if signedIn();
      allow create: if signedIn() && incoming().status == 'pending';
      allow update: if isAdmin();                                // publish / refuse
      allow delete: if isAdmin() || (signedIn() && resource.data.get('status', '') == 'rejected');
    }

    // Push registrations. One doc per FCM token, id = the token itself.
    // Never readable; Cloud Functions read them with the Admin SDK. Delete
    // is open so sign-out can remove it after the session has ended — it
    // needs the unguessable token id.
    match /bbAnonPush/{token} {
      allow read: if false;
      allow create, update: if signedIn()
        && incoming().token == token
        && incoming().keys().hasOnly(
             ['token', 'prefs', 'monikaLower', 'emailHash', 'platform', 'bundle', 'lang', 'updatedAt'])
        // Older builds still send emailHash (stripped server-side as it lands).
        && (legacyClients() || !('emailHash' in incoming()));
      allow delete: if true;
    }

    // ── Live-now presence (no identity stored, just lastSeen) ──
    match /bbPresence/{session} {
      allow read: if true;
      allow create, update: if incoming().keys().hasOnly(['lastSeen']);
      allow delete: if true;
    }
    match /bbAnonPresence/{session} {
      allow read: if true;
      allow create, update: if incoming().keys().hasOnly(['lastSeen']);
      allow delete: if true;
    }

    // ── Community counters: members move a count by one at a time ──
    match /counters/{doc} {
      allow read: if true;
      allow create: if signedIn()
        && incoming().keys().hasOnly(['count'])
        && incoming().count is int
        && incoming().count >= -1 && incoming().count <= 1;
      allow update: if signedIn() && changedKeys().hasOnly(['count']) && stepped('count');
    }

    // ── Private per-user data ──
    // These userSettings fields are kept only inside `secureEnc`, encrypted
    // on the device with the journal's data key (js/shared/secure-store.js).
    // Older builds still write them in plaintext; the next sign-in on a current
    // build folds them in and deletes them.
    function sensitiveSettings() {
      return ['currentMedList', 'moodDefinitions', 'moodMemories', 'copingStrategies',
              'myCommitments', 'customReminders', 'survivalGratitude', 'rememberThis'];
    }
    function noNewPlaintext() {
      return legacyClients()
        || (resource == null
            ? !incoming().keys().hasAny(sensitiveSettings())
            : !incoming().diff(resource.data).addedKeys().hasAny(sensitiveSettings())
              && !incoming().diff(resource.data).changedKeys().hasAny(sensitiveSettings()));
    }
    match /userSettings/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && noNewPlaintext();
    }
    // Personal details: only `secureEnc` (+ updatedAt) once older builds are gone.
    match /personalDetails/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && (legacyClients() || incoming().keys().hasOnly(['secureEnc', 'updatedAt']));
    }
    match /entries/{docId} {
      allow read, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == incoming().userId;
      allow update: if signedIn()
                    && request.auth.uid == resource.data.userId
                    && request.auth.uid == incoming().userId;
    }

    // ── In-app feedback (write-only drop box) ──
    match /feedback/{docId} { allow create: if signedIn(); }

    // No catch-all: anything not matched above is denied.
  }
}
